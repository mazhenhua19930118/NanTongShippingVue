<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dispatch.mapper.ShippingDispatchMapper">
    
    <resultMap type="ShippingDispatch" id="ShippingDispatchResult">
        <result property="id"    column="id"    />
        <result property="orderId"    column="order_id"    />
        <result property="deposit"    column="deposit"    />
        <result property="shippingCost"    column="shipping_cost"    />
        <result property="isNeedSubSign"    column="is_need_sub_sign"    />
    </resultMap>

    <sql id="selectShippingDispatchVo">
        select id, order_id, deposit, shipping_cost, is_need_sub_sign from shipping_dispatch
    </sql>

<!--    <select id="selectShippingDispatchList" parameterType="ShippingDispatch" resultMap="ShippingDispatchResult">-->
