    <select id="selectShippingFinanceList" parameterType="ShippingFinance" resultMap="ShippingFinanceResult">
        select f.* from shipping_finance f inner join shipping_goods g on f.order_id = g.order_id
        <where>
            <if test="orderId != null  and orderId != ''"> and f.order_id = #{orderId}</if>
            <if test="isAdvancePayment != null  and isAdvancePayment != ''"> and f.is_advance_payment = #{isAdvancePayment}</if>
            <if test="weight != null "> and f.weight = #{weight}</if>
            <if test="weightUnit != null  and weightUnit != ''"> and f.weight_unit = #{weightUnit}</if>
            <if test="subOrderPrice != null "> and f.sub_order_price = #{subOrderPrice}</if>
            <if test="mainOrderPrice != null "> and f.main_order_price = #{mainOrderPrice}</if>
            <if test="aboveLimitWeight != null "> and f.above_limit_weight = #{aboveLimitWeight}</if>
            <if test="aboveLimitWeightUnit != null  and aboveLimitWeightUnit != ''"> and f.above_limit_weight_unit = #{aboveLimitWeightUnit}</if>
            <if test="goodsPrice != null "> and f.goods_price = #{goodsPrice}</if>
            <if test="paymentAmount != null "> and f.payment_amount = #{paymentAmount}</if>
            <if test="settlementAmount != null "> and f.settlement_amount = #{settlementAmount}</if>
            <if test="deferredPayment != null "> and f.deferred_payment = #{deferredPayment}</if>
            <if test="deferredSettlement != null "> and f.deferred_settlement = #{deferredSettlement}</if>
            <if test="isUploadDetailsManagement != null  and isUploadDetailsManagement != ''"> and f.is_upload_details_management = #{isUploadDetailsManagement}</if>
            <if test="floatRate != null  and floatRate != ''"> and f.float_rate = #{floatRate}</if>
            <if test="taskStatus != null  and taskStatus != ''"> and g.status = #{taskStatus}</if>
        </where>
    </select>
    
    <select id="selectShippingFinanceById" parameterType="Long" resultMap="ShippingFinanceResult">
        <include refid="selectShippingFinanceVo"/>
        where id = #{id}
    </select>

